{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "swarm-doctrine",
    "compatibility_date": "2026-09-28",
    "workers_dev": true,
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
    },
    "build": {
        "command": "npm run build"
    },
    "previews": {}
}
